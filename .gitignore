# ========================
#  后端服务（独立私有仓库管理，不在此仓库跟踪）
# ========================
server/

# ========================
#  MkDocs 构建产物
# ========================
# 必须写成 /site/：不加开头斜杠时 git 会在**任意层级**匹配名为 site 的目录，
# 于是 scripts/site/（changelog、贡献者、链接检查三个生成器）被一起静默忽略，
# 推上远端后 CI 里找不到这些脚本，三个测试直接 FileNotFoundError。踩过一次，别改回去。
/site/
ujn-guide-site.zip
!scripts/site/
!scripts/site/**

# ========================
#  部署配置、运维文档与本机发布材料（不进入版本控制）
# ========================
deploy/*
.Nexus/

# ========================
#  Python
# ========================
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# ========================
#  编辑器 / IDE
# ========================
.vscode/
.idea/
*.swp
*.swo
*~

# ========================
#  系统文件
# ========================
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ========================
#  Jupyter Notebook
# ========================
.ipynb_checkpoints/

# ========================
#  环境变量（不提交真实密钥）
# ========================
.env
.env.local
.env.*
.env.*.local
# 但 .env.example 作为模板需要提交
!.env.example
!**/.env.example
.envrc
.direnv/
.dev.vars
.dev.vars.*
!.dev.vars.example
!**/.dev.vars.example
.wrangler/

# 包管理器/CLI 的本机认证配置可能包含访问令牌
.npmrc
.netrc
pip.conf
pip.ini
test_worker.local.ps1
test_worker.local.sh

# ========================
#  日志
# ========================
*.log

# ========================
#  测试 & 覆盖率报告
# ========================
.coverage
coverage_html_report/
htmlcov/
.coverage.*
coverage/
.nyc_output/
playwright-report/
test-results/
reports/
vitest-front.json

# ========================
#  缓存（工具/框架可能生成）
# ========================
.cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ========================
#  MkDocs 临时缓存
# ========================
.cache/
mkdocs*.cache

# ========================
#  Node.js（如果用到）
# ========================
node_modules/
.npm/
.pnpm-store/
.eslintcache
# package-lock.json 是可复现安装所需的公开锁文件，不应忽略

# ========================
#  SQLite 数据库（宠物收集录 v4 后端）
# ========================
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3-journal
*.bak
*.backup
*.dump
*.sql.gz
**/backups/
uploads/
tmp/
temp/

# 审计归档包含管理操作、操作者与目标对象信息
**/audit-archives/
audit-cleanup-*.jsonl
audit-cleanup-*.jsonl.manifest.json

# 迁移清单、校验报告、打包目录可能暴露绝对路径、数据清单与哈希
migration-manifest*.json
migration-verification*.json
migration-report*.json
migration-artifacts/
migration-packages/
migration-package-*/

# Lsky 数据库导出与存储快照不得进入公开仓库
lsky.sql
lsky.sql.gz
lsky-dump*.sql
lsky-dump*.sql.gz
lsky-backup*.sql
lsky-backup*.sql.gz
lsky*.dump
lsky-storage/
lsky-storage-snapshot*/

# ========================
#  私钥、证书容器与本地凭据导出
# ========================
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ovpn
**/credentials*.json
**/secrets*.json
**/*service-account*.json
**/firebase-adminsdk*.json

# 云平台、容器、SSH/Kubernetes 与 IaC 本机状态
.aws/
.ssh/
.kube/
**/.docker/config.json
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
crash.log
