{
  "name": "ujn-guide-build-tools",
  "private": true,
  "version": "1.0.0",
  "description": "济南大学校园通静态站构建工具链",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "python scripts/build_site.py",
    "dev:site": "node tools/grade-export/server.mjs",
    "test:build": "python -m unittest discover -s tests -p test_*.py",
    "test:frontend": "vitest run",
    "verify:site": "python scripts/verify_site_build.py",
    "verify": "powershell -ExecutionPolicy Bypass -File ./verify.ps1 -Target site",
    "verify:ui": "node scripts/verify/fingerprint.mjs",
    "verify:ui:compare": "python scripts/verify/compare_fingerprint.py",
    "verify:responsive": "node scripts/verify/responsive-sweep.mjs",
    "verify:links": "python scripts/site/check_links.py",
    "verify:hit": "node scripts/verify/hit-test.mjs",
    "start:grades": "node tools/grade-export/server.mjs",
    "test:grades": "node --test tests/grade-export/*.test.mjs && node tools/grade-export/test-endpoint.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "pagefind": "1.5.2",
    "vitest": "3.2.7"
  }
}
