[Unit]
Description=UJN Guide pet submission backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/ujn-guide/current/server
EnvironmentFile=/etc/ujn-guide/pet.env
EnvironmentFile=/srv/ujn-guide/current/server/release.env
ExecStart=/usr/bin/node /srv/ujn-guide/current/server/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/ujn-guide

[Install]
WantedBy=multi-user.target
